{
  "name": "digital-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "db:init": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/init.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "local:db": "tsx scripts/local-db.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "exceljs": "4.4.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "svg-to-pdfkit": "0.1.8",
    "zod": "^4.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/svg-to-pdfkit": "^0.1.3",
    "embedded-postgres": "^18.1.0-beta.15",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
